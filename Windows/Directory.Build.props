<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Invariant mode throws for any culture name but the invariant one, and
      WPF asks for "en" and others the first time it lays out text
      (MS.Internal.FontCache.MajorLanguages), so every window with text would
      fail. This allows named cultures; they still behave like the invariant
      one, so numbers keep "." and "," everywhere.
    -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
  </PropertyGroup>
</Project>
