<!--
  The window style every Lumerist window shares, merged into the
  application's resources at startup. Colours and fonts come from
  Design/Theme.cs as DynamicResource, so they follow a theme change. The
  control templates (the Mac's Components.swift) live in
  Design/Controls/ControlStyles.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="Synth.Window" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Synth.Abyss}" />
    <Setter Property="Foreground" Value="{DynamicResource Synth.Body}" />
    <Setter Property="FontFamily" Value="{DynamicResource Synth.Font.Text}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>
</ResourceDictionary>
