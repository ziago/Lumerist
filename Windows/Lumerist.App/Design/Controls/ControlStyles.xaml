<!--
  Templates of the Synth controls (the Mac's Design/Components.swift and
  Design/KeySlot.swift). Two looks per control: ".Flat" for Galerist (square,
  hairlines, mono small caps) and ".Neon" for Miami (rounded outlines, glow).
  Code picks the key with Theme.IsFlat (see SynthControls); windows are
  rebuilt on a theme change, and every colour is a DynamicResource token.
  The implicit styles at the end (scroll bars, tool tips) apply where this
  dictionary is merged into a window's resources.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Lumerist.App.Design.Controls"
                    x:Class="Lumerist.App.Design.Controls.ControlStyles"
                    x:ClassModifier="internal">

  <!-- Keyboard focus: an amber outline (the Mac's focus ring). -->
  <Style x:Key="Synth.FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-2" Stroke="{DynamicResource Synth.Amber}" StrokeThickness="1" StrokeDashArray="2 2" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A button with no chrome: the content is the whole face (key boxes, cards, tabs, keys). -->
  <Style x:Key="Synth.Button.Plain" TargetType="ButtonBase">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Synth.FocusVisual}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Galerist buttons: square, mono small caps; content is a SpacedText. -->
  <ControlTemplate x:Key="Synth.Button.Flat.Template" TargetType="Button">
    <Grid MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
      <Rectangle x:Name="Fill" Fill="{TemplateBinding Background}" />
      <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
    </Grid>
    <ControlTemplate.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsPressed" Value="True" />
          <Condition Property="Tag" Value="primary" />
        </MultiTrigger.Conditions>
        <Setter TargetName="Fill" Property="Opacity" Value="0.82" />
      </MultiTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="Synth.Button.Flat.Base" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource Synth.Font.Mono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Synth.FocusVisual}" />
    <Setter Property="Template" Value="{StaticResource Synth.Button.Flat.Template}" />
  </Style>

  <Style x:Key="Synth.Button.Flat.Primary" TargetType="Button" BasedOn="{StaticResource Synth.Button.Flat.Base}">
    <Setter Property="Tag" Value="primary" />
    <Setter Property="Foreground" Value="{DynamicResource Synth.OnMagenta}" />
    <Setter Property="Background" Value="{DynamicResource Synth.Magenta}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Synth.Disabled}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Synth.GridLine}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Synth.Button.Flat.Secondary" TargetType="Button" BasedOn="{StaticResource Synth.Button.Flat.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Synth.Ice}" />
    <Setter Property="Background" Value="{DynamicResource Synth.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Synth.Outline}" />
    <Style.Triggers>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Synth.GridLine}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Synth.Disabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Synth.GridLine}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- The REC red never goes on a button: the confirmation marks what is destructive. -->
  <Style x:Key="Synth.Button.Flat.Destructive" TargetType="Button" BasedOn="{StaticResource Synth.Button.Flat.Secondary}" />

  <Style x:Key="Synth.Button.Flat.Quiet" TargetType="Button" BasedOn="{StaticResource Synth.Button.Flat.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Synth.Body}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="4,0" />
    <Style.Triggers>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Synth.Steel}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Synth.Disabled}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Miami buttons: rounded outlines in Chakra Petch caps; the primary one glows. -->
  <ControlTemplate x:Key="Synth.Button.Neon.Template" TargetType="Button">
    <Border x:Name="Frame" MinHeight="{TemplateBinding MinHeight}" Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Synth.Radius.Control}"
            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
    </Border>
  </ControlTemplate>

  <Style x:Key="Synth.Button.Neon.Base" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource Synth.Font.Display}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Synth.FocusVisual}" />
    <Setter Property="Template" Value="{StaticResource Synth.Button.Neon.Template}" />
  </Style>

  <Style x:Key="Synth.Button.Neon.Primary" TargetType="Button" BasedOn="{StaticResource Synth.Button.Neon.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Synth.OnMagenta}" />
    <Setter Property="Background" Value="{DynamicResource Synth.Magenta}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect ShadowDepth="0" BlurRadius="18" Opacity="0.55" Color="#FF3EA5" />
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Synth.MagentaLight}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Synth.Disabled}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Synth.GridLine}" />
        <Setter Property="Effect" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Synth.Button.Neon.Secondary" TargetType="Button" BasedOn="{StaticResource Synth.Button.Neon.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Synth.Teal}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Synth.Teal}" />
    <Style.Triggers>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Synth.TealLight}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Synth.TealLight}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Synth.Disabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Synth.GridLine}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Synth.Button.Neon.Destructive" TargetType="Button" BasedOn="{StaticResource Synth.Button.Neon.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Synth.Error}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Synth.Error}" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Synth.Disabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Synth.GridLine}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Synth.Button.Neon.Quiet" TargetType="Button" BasedOn="{StaticResource Synth.Button.Neon.Base}">
    <Setter Property="Foreground" Value="{DynamicResource Synth.Steel}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="6,0" />
    <Style.Triggers>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Synth.Ice}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Synth.Disabled}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Galerist's square switch (38 × 22): ink box, knob right when on; grey outline, knob left when off.
       Indeterminate (IsChecked null) draws "on its way": knob centred, ink outline. -->
  <Style x:Key="Synth.Switch.Flat" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Synth.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="38" Height="22" Background="Transparent" SnapsToDevicePixels="True">
            <Rectangle x:Name="Fill" Fill="Transparent" />
            <Border x:Name="Frame" BorderThickness="1" BorderBrush="{DynamicResource Synth.Steel}" />
            <Rectangle x:Name="Knob" Width="14" Height="14" Margin="4,0" HorizontalAlignment="Left" Fill="{DynamicResource Synth.Steel}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Fill" Property="Fill" Value="{DynamicResource Synth.Magenta}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Synth.Magenta}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Synth.OnMagenta}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Synth.Magenta}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Center" />
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Synth.Magenta}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Synth.Disabled}" />
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Synth.Disabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsEnabled" Value="False" />
                <Condition Property="IsChecked" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Fill" Property="Fill" Value="{DynamicResource Synth.Disabled}" />
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Synth.Panel}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Miami's switch spells its state: OFF | ON, the current one filled. -->
  <Style x:Key="Synth.Switch.Neon" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Synth.FocusVisual}" />
    <Setter Property="FontFamily" Value="{DynamicResource Synth.Font.Mono}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Frame" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource Synth.Steel}"
                  CornerRadius="{DynamicResource Synth.Radius.Control}" Padding="2" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Off" Height="20" Padding="7,0" CornerRadius="2" Background="{DynamicResource Synth.Steel}">
                <c:SpacedText x:Name="OffText" Text="OFF" Tracking="1" VerticalAlignment="Center" Foreground="{DynamicResource Synth.Abyss}" />
              </Border>
              <Border x:Name="On" Height="20" Padding="8,0" CornerRadius="2" Background="Transparent">
                <c:SpacedText x:Name="OnText" Text="ON" Tracking="1" VerticalAlignment="Center" Foreground="{DynamicResource Synth.Steel}" />
              </Border>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Off" Property="Background" Value="Transparent" />
              <Setter TargetName="OffText" Property="Foreground" Value="{DynamicResource Synth.Steel}" />
              <Setter TargetName="On" Property="Background" Value="{DynamicResource Synth.Magenta}" />
              <Setter TargetName="OnText" Property="Foreground" Value="{DynamicResource Synth.OnMagenta}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Synth.Magenta}" />
              <Setter TargetName="Frame" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect ShadowDepth="0" BlurRadius="16" Opacity="0.4" Color="#FF3EA5" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Synth.Disabled}" />
              <Setter TargetName="Frame" Property="Effect" Value="{x:Null}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsEnabled" Value="False" />
                <Condition Property="IsChecked" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="On" Property="Background" Value="{DynamicResource Synth.Disabled}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsEnabled" Value="False" />
                <Condition Property="IsChecked" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Off" Property="Background" Value="{DynamicResource Synth.Disabled}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented control cells (RadioButtons; content is a SpacedText). -->
  <Style x:Key="Synth.Segment.Flat" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource Synth.Font.Mono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Synth.Ice}" />
    <Setter Property="Background" Value="{DynamicResource Synth.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Synth.Outline}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Synth.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border Height="32" Padding="14,0" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="False" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Synth.OnMagenta}" />
        <Setter Property="Background" Value="{DynamicResource Synth.Magenta}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Synth.Magenta}" />
        <Setter Property="Panel.ZIndex" Value="1" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Synth.Disabled}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsEnabled" Value="False" />
          <Condition Property="IsChecked" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource Synth.Panel}" />
        <Setter Property="Background" Value="{DynamicResource Synth.Disabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Synth.Disabled}" />
      </MultiTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Synth.Segment.Neon" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource Synth.Font.Mono}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Synth.Steel}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Synth.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border Height="26" Padding="12,0" Background="{TemplateBinding Background}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="False" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Synth.OnMagenta}" />
        <Setter Property="Background" Value="{DynamicResource Synth.Magenta}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Synth.Disabled}" />
        <Setter Property="Cursor" Value="Arrow" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsEnabled" Value="False" />
          <Condition Property="IsChecked" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource Synth.OnMagenta}" />
        <Setter Property="Background" Value="{DynamicResource Synth.Disabled}" />
      </MultiTrigger>
    </Style.Triggers>
  </Style>

  <!-- Number and text fields: monospaced, on abyss (Miami) or white (Galerist), 1 px outline. -->
  <Style x:Key="Synth.Field" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource Synth.Font.Mono}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Synth.Ice}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Synth.Teal}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Synth.Teal}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Synth.Outline}" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="{DynamicResource Synth.Radius.Control}" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Synth.Teal}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Synth.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The text box inside SynthControls.SearchField: no frame of its own. -->
  <Style x:Key="Synth.SearchText" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource Synth.Font.Text}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Synth.Ice}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Synth.Teal}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Synth.Teal}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Background="Transparent"
                        HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Sliders: a thin track filled in teal up to a round knob. -->
  <Style x:Key="Synth.Slider.Fill" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent">
            <Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource Synth.Teal}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Synth.Slider.Empty" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Synth.Slider.Thumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{DynamicResource Synth.Panel}" Stroke="{DynamicResource Synth.Teal}" StrokeThickness="2" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Synth.Teal}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Synth.Slider" TargetType="Slider">
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Synth.FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="20" Background="Transparent">
            <Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource Synth.Outline}" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Synth.Slider.Fill}" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Synth.Slider.Empty}" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource Synth.Slider.Thumb}" />
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Menus (the Mac's NSMenu pop-ups): themed, scrolling when long. -->
  <Style x:Key="Synth.ContextMenu" TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="{DynamicResource Synth.Font.Text}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Synth.Ice}" />
    <Setter Property="Background" Value="{DynamicResource Synth.PanelRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Synth.Outline}" />
    <Setter Property="HasDropShadow" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="{DynamicResource Synth.Radius.Control}" Padding="0,4" MaxHeight="{TemplateBinding MaxHeight}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Synth.MenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Synth.Ice}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Row" Background="Transparent" Padding="8,4,16,4" Margin="4,0" CornerRadius="{DynamicResource Synth.Radius.Row}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                         VerticalAlignment="Center" Visibility="Hidden" />
              <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="False" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Synth.Teal}" />
              <Setter Property="Foreground" Value="{DynamicResource Synth.OnTeal}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Synth.Steel}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Synth.MenuSeparator" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Rectangle Height="1" Margin="8,4" Fill="{DynamicResource Synth.GridLine}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Implicit: slim scroll bars and themed tool tips in every window that merges this dictionary. -->
  <Style x:Key="Synth.ScrollBar.Thumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" Margin="2" CornerRadius="3" Background="{DynamicResource Synth.Outline}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Synth.Steel}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource Synth.Slider.Empty}" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource Synth.Slider.Empty}" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource Synth.ScrollBar.Thumb}" />
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource Synth.Slider.Empty}" />
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource Synth.Slider.Empty}" />
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource Synth.ScrollBar.Thumb}" />
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Tooltips: the app-wide implicit style in Design/Styles.xaml (a window-level one here would hide it). -->
</ResourceDictionary>
