<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure logic, no Windows APIs: builds and tests on any system. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lumerist.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lumerist.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lightroom Classic's own keys (LightroomShortcuts.cs), read from the shared file itself. -->
    <EmbeddedResource Include="..\..\Shared\lightroom-shortcuts.json" LogicalName="lightroom-shortcuts.json" Link="Shared\lightroom-shortcuts.json" />
  </ItemGroup>
</Project>
